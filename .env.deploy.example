# Configure the actual Redis connection in the hosting secrets, never in git.
RATELIMIT_STORAGE_URI=redis://redis:6379/0
WEB_CONCURRENCY=2
SCHEDULER_IN_WEB=0
GUNICORN_TIMEOUT=120
# Docker starts scripts/start_server.py: schema bootstrap + scheduler + Gunicorn.
# Without shared storage, use exactly one worker and one replica.
